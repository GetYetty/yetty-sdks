{
  "name": "@getyetty-sdk/qonto",
  "version": "2026.8.5",
  "description": "TypeScript client for the Qonto API, auto-generated from OpenAPI spec",
  "keywords": [
    "api",
    "banking",
    "client",
    "openapi",
    "qonto",
    "sepa",
    "typescript"
  ],
  "license": "MIT",
  "author": "GetYetty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GetYetty/yetty-sdks.git",
    "directory": "packages/qonto"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "check-spec-changes": "node ../../scripts/check-spec-changes.ts --spec-file ./business_api.yml --hash-file ./openapi.hash",
    "bump-version": "node ../../scripts/bump-version.ts .",
    "generate": "openapi-ts",
    "build": "tsdown",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@stoplight/prism-cli": "^5.15.11",
    "@types/node": "^25.9.1",
    "tsdown": "^0.22.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
