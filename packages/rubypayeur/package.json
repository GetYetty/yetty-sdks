{
  "name": "@getyetty-sdk/rubypayeur",
  "version": "2026.8.7-1",
  "description": "TypeScript client for the RubyPayeur scoring and debt recovery APIs",
  "keywords": [
    "api",
    "client",
    "debt-recovery",
    "rubypayeur",
    "scoring",
    "typescript"
  ],
  "license": "MIT",
  "author": "GetYetty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GetYetty/yetty-sdks.git",
    "directory": "packages/rubypayeur"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "bump-version": "node ../../scripts/bump-version.ts .",
    "build": "tsdown",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "luxon": "^3.6.1",
    "p-retry": "^6.2.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/luxon": "^3.6.2",
    "@types/node": "^25.9.1",
    "tsdown": "^0.22.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
