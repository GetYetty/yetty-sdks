{
  "name": "@getyetty-sdk/pennylane",
  "version": "2026.9.2",
  "description": "TypeScript client for the Pennylane Accounting API, auto-generated from OpenAPI spec",
  "keywords": [
    "accounting",
    "api",
    "client",
    "openapi",
    "pennylane",
    "typescript"
  ],
  "license": "MIT",
  "author": "GetYetty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GetYetty/yetty-sdks.git",
    "directory": "packages/pennylane"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "fetch-spec": "curl -o openapi.json https://pennylane.readme.io/openapi/accounting.json",
    "check-spec-changes": "node ../../scripts/check-spec-changes.ts --spec-url https://pennylane.readme.io/openapi/accounting.json --hash-file ./openapi.hash --output ./openapi.json",
    "generate-recap": "node ../../scripts/generate-recap.ts --spec-git-path packages/pennylane/openapi.json --repo-url https://github.com/GetYetty/yetty-sdks",
    "bump-version": "node ../../scripts/bump-version.ts .",
    "generate": "openapi-ts && npm run format",
    "build": "tsdown",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@mistralai/mistralai": "^2.2.5",
    "@stoplight/prism-cli": "^5.15.11",
    "@types/node": "^25.9.1",
    "tsdown": "^0.22.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
