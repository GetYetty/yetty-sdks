{
  "name": "@getyetty-sdk/zohobooks",
  "version": "2026.8.8",
  "description": "TypeScript client for the ZohoBooks API — authenticated HTTP, OAuth2, and rate limiting",
  "keywords": ["api", "client", "invoice", "oauth2", "typescript", "zohobooks"],
  "license": "MIT",
  "author": "GetYetty",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GetYetty/yetty-sdks.git",
    "directory": "packages/zohobooks"
  },
  "files": ["dist", "README.md"],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.mts",
      "default": "./dist/testing/index.mjs"
    }
  },
  "scripts": {
    "bump-version": "node ../../scripts/bump-version.ts .",
    "build": "tsdown",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "bottleneck": "^2.19.5",
    "p-retry": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsdown": "^0.22.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
